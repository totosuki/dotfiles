# p10k
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


# binutils
export PATH="/usr/local/opt/binutils/bin:$PATH"

# Rancher Desktop
export PATH="/Users/totosuki/.rd/bin:$PATH"

# vscode
alias code="/Applications/Visual\\ Studio\\ Code.app/Contents/Resources/app/bin/code"

# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
plugins=(
    copypath
    zsh-autosuggestions
    zsh-syntax-highlighting
)
source $ZSH/oh-my-zsh.sh

# Homebrew
eval "$(/opt/homebrew/bin/brew shellenv)"

# aliases
alias bcd="source $HOME/tools/commands/bcd.sh"
alias edit="$HOME/Software/edit/target/release/edit"
alias edit-fork="$HOME/Project/edit/target/release/edit"
alias ipshow="$HOME/tools/commands/ipshow.sh"
alias lchat-client="$HOME/Project/lchat/lchat/target/release/client"
alias lchat-server="$HOME/Project/lchat/lchat/target/release/server"
alias g="source $HOME/tools/commands/g.sh"
alias glog="source $HOME/tools/commands/glog.sh"
alias jmp="source jmp"
alias vcomp="$HOME/tools/commands/vcomp.sh"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
